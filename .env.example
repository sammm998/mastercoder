# ---------- Core ----------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001
DATABASE_URL=postgres://forge:forge@localhost:5432/forge
REDIS_URL=redis://localhost:6379
# 32+ byte hex/base64 master key for the secrets vault (envelope encryption KEK). Generate: openssl rand -hex 32
VAULT_MASTER_KEY=
# Session signing secret for platform auth. Generate: openssl rand -hex 32
AUTH_SECRET=
DATA_REGION=eu-central-1

# ---------- Object storage (S3 / MinIO) ----------
STORAGE_PROVIDER=s3            # s3 | local
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=forge
S3_SECRET_ACCESS_KEY=forgeforge
S3_BUCKET=forge-artifacts
S3_RECORDINGS_BUCKET=forge-recordings
LOCAL_STORAGE_DIR=.data/storage

# ---------- Email ----------
EMAIL_PROVIDER=smtp            # smtp | mock
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Forge <noreply@forge.local>"

# ---------- LLM ----------
LLM_PROVIDER=mock              # anthropic | openai | mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_PLANNER=claude-opus-5-5
MODEL_BUILDER=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5
MODEL_VISION_REVIEW=claude-sonnet-5-5
LLM_FALLBACKS=default          # server-side refusal fallback for Claude 5.5 models: default | off

# ---------- Sandbox ----------
SANDBOX_PROVIDER=docker        # e2b | daytona | docker | local
E2B_API_KEY=
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
SANDBOX_IMAGE=node:22-bookworm-slim
SANDBOX_CPU=1
SANDBOX_MEMORY_MB=1024
SANDBOX_TIMEOUT_SEC=900
SANDBOX_EGRESS_ALLOWLIST=registry.npmjs.org,pypi.org,files.pythonhosted.org

# ---------- Database branching for checkpoints ----------
DB_BRANCH_PROVIDER=pgclone     # neon | pgclone
NEON_API_KEY=
NEON_PROJECT_ID=

# ---------- Media ----------
MEDIA_PROVIDER=mock            # fal | replicate | mock
FAL_KEY=
REPLICATE_API_TOKEN=
MEDIA_PRICE_OVERRIDES=          # JSON {"model": usdPerUnit} to correct list prices
MEDIA_MOCK_VIDEO_FORMAT=        # mp4 | webp (mock video output)
REMOTION_BROWSER_EXECUTABLE=    # chrome-headless-shell path for Remotion renders
REMOTION_LICENSE_KEY=           # required for companies > 3 employees (see packages/media README)

# ---------- Speech ----------
STT_PROVIDER=mock              # elevenlabs | deepgram | whisper | mock
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
WHISPER_URL=http://localhost:9010
WHISPER_MODEL=KBLab/kb-whisper-large
WHISPER_API_KEY=
WHISPER_GPU_USD_PER_HOUR=
WHISPER_REALTIME_FACTOR=
ELEVENLABS_BASE_URL=
ELEVENLABS_STT_MODEL=
DEEPGRAM_BASE_URL=
DEEPGRAM_MODEL=nova-3

# ---------- Meetings ----------
MEETING_BOT_PROVIDER=mock      # recall | meetstream | vexa | mock
RECALL_API_KEY=
RECALL_REGION=eu-central-1
MEETSTREAM_API_KEY=
VEXA_URL=
VEXA_API_KEY=
RECALL_WEBHOOK_SECRET=
MEETSTREAM_BASE_URL=
MEETSTREAM_WEBHOOK_SECRET=
MEETSTREAM_USD_PER_HOUR=
VEXA_WEBHOOK_SECRET=
VEXA_USD_PER_HOUR=
CALENDAR_PROVIDER=mock          # google | microsoft | mock
MEETINGS_ALLOW_UNSIGNED_WEBHOOKS=false   # dev only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------- Integrations ----------
CONNECTOR_PROVIDER=mock        # composio | nango | pipedream | mock
COMPOSIO_API_KEY=
NANGO_SECRET_KEY=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=

# ---------- Billing ----------
BILLING_PROVIDER=mock          # stripe | mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Deploy / hosting ----------
DEPLOY_PROVIDER=local          # fly | local
FLY_API_TOKEN=
FLY_ORG=
FLY_REGION=arn
DEPLOY_BASE_DOMAIN=forge.local

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
LOG_LEVEL=info

# ---------- Abuse / rate limits ----------
RATE_LIMIT_PER_MIN_USER=120
RATE_LIMIT_PER_MIN_IP=300
TURNSTILE_SECRET=
