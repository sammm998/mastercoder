{
  "name": "forge",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @forge/db migrate",
    "up": "docker compose up -d && pnpm db:migrate",
    "start:all": "bash scripts/start.sh",
    "bench": "pnpm --filter @forge/evals bench",
    "load-test": "pnpm --filter @forge/evals load-test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@swc/core",
      "better-sqlite3",
      "protobufjs",
      "unrs-resolver",
      "@parcel/watcher",
      "core-js"
    ]
  }
}
