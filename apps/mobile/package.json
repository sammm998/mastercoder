{
  "name": "@forge/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Forge mobile app (Expo): chat, voice prompts, in-person meeting recording, previews",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint src app test scripts",
    "test": "vitest run",
    "doctor": "expo-doctor",
    "test:e2e": "tsx test/e2e/web-smoke.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@forge/api": "workspace:*",
    "@forge/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.106.1",
    "@trpc/client": "^11.24.0",
    "@trpc/react-query": "^11.24.0",
    "@trpc/server": "^11.24.0",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "superjson": "^2.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@forge/db": "workspace:*",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.3.0",
    "eslint-plugin-react-hooks": "^7.0.0"
  }
}
