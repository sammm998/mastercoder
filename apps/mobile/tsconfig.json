{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "app",
    "src",
    "test",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "test/e2e",
    "node_modules",
    "dist"
  ]
}
