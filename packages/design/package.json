{
  "name": "@forge/design",
  "version": "0.1.0",
  "private": true,
  "description": "Art direction, design tokens, motion/3D pattern library, site composer, visual QA and Lighthouse for Forge",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.patterns.json",
    "typecheck:patterns": "tsc -p tsconfig.patterns.json",
    "lint": "eslint src test patterns",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@forge/llm": "workspace:*",
    "@forge/shared": "workspace:*",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.6.0",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  }
}
