{
  "name": "@forge/quality-gates",
  "version": "0.1.0",
  "private": true,
  "description": "Quality, security and performance gates run inside a sandbox",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@forge/sandbox": "workspace:*",
    "@forge/shared": "workspace:*",
    "zod": "^3.25.76"
  }
}
