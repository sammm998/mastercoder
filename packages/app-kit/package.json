{
  "name": "@forge/app-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Kit files for generated apps plus platform services: DB branching, deploy, AI gateway, GitHub export, error ingest, Expo",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
