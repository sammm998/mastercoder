    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@forge/llm": "workspace:*",
    "@forge/shared": "workspace:*",
    "@forge/templates": "workspace:*",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.2"
  }
}
