{
  "name": "@forge/observability",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTelemetry tracing, Sentry adapter, provider health checks, cost/failure alerts",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
